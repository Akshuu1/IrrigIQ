{
  "name": "irrigiq",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @irrigiq/api",
    "dev:web": "npm run dev -w @irrigiq/web",
    "build": "npm run build -w @irrigiq/shared && npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-e2e.mjs",
    "e2e": "node scripts/run-e2e.mjs",
    "loadtest": "k6 run infra/loadtest/loadtest.js",
    "seed": "npm run seed -w @irrigiq/api",
    "simulate": "npm run simulate -w @irrigiq/simulator --",
    "i18n:report": "node scripts/i18n-report.mjs",
    "registry:scan": "node scripts/generate-agronomy-registry.mjs",
    "bench:perf": "node --import tsx apps/api/src/benchmark/perf-benchmark.ts",
    "migrate:blind-index": "node --import tsx scripts/migrate-blind-index.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "husky": "^9.1.7",
    "prettier": "^3.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  },
  "overrides": {
    "tinypool": "^2.2.0"
  }
}
